# Every environment variable the server reads. Copy to .env and fill in; .env is git-ignored.

# Redis connection. Use rediss:// for TLS; put a password in the URL (never commit it).
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_SECONDS=2

# Where the MCP endpoint listens. Keep 127.0.0.1 unless auth is on and you mean to expose it.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Bearer token clients must send (32+ characters). Optional on 127.0.0.1, required otherwise.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# URL clients use to reach this server (required when MCP_HOST is not loopback),
# e.g. https://cache.example.com. Defaults to http://127.0.0.1:<MCP_PORT>.
MCP_PUBLIC_URL=
# Extra Host header values to accept, comma-separated (e.g. behind a reverse proxy).
MCP_ALLOWED_HOSTS=

# Namespacing and expiry for cached values.
CACHE_KEY_PREFIX=mcpcache
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_MAX_TTL_SECONDS=604800
