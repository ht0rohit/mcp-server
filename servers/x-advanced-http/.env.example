# --- Upstream: the X API ---------------------------------------------------------------------
# App-only bearer token for the read tools (developer.x.com > your app > Keys and tokens).
X_BEARER_TOKEN=
# Optional. OAuth 2.0 *user* access token with tweet.read, tweet.write and users.read scopes.
# When set, the server also exposes the write tools and the x://me/posts resource.
X_USER_ACCESS_TOKEN=

# --- This server: who may call it -------------------------------------------------------------
# Required. Bearer tokens clients must send, with the scopes each one grants.
# Entries are separated by ';', scopes by ','. Generate tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKENS=replace-me-read=x:read;replace-me-write=x:read,x:write

# --- This server: where it listens ------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8000
# The URL clients use to reach /mcp. Tokens are bound to it and it appears in the auth metadata.
MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
# Extra Host headers to accept, comma-separated (DNS-rebinding protection). Localhost is always
# allowed. Example: mcp.example.com,mcp.example.com:*
MCP_ALLOWED_HOSTS=
# Optional. Shared secrets (comma-separated, first one seals) so every worker can open the
# requestState of confirmation round-trips. Needed with more than one worker or replica.
MCP_STATE_KEYS=
